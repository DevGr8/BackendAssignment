{
  "info": {
    "name": "College Election Voting System",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "electionId",
      "value": ""
    },
    {
      "key": "candidateId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register student",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json(); if (j.token) pm.collectionVariables.set(\"token\", j.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": "{{baseUrl}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Asha Patil\",\n  \"email\": \"asha@college.edu\",\n  \"rollNumber\": \"CSE001\",\n  \"password\": \"secret123\"\n}"
            }
          }
        },
        {
          "name": "Login (student or admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json(); if (j.token) pm.collectionVariables.set(\"token\", j.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@college.edu\",\n  \"password\": \"Admin@12345\"\n}"
            }
          }
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{baseUrl}}/auth/me"
          }
        }
      ]
    },
    {
      "name": "Elections (admin)",
      "item": [
        {
          "name": "Create election + candidates",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json(); pm.collectionVariables.set(\"electionId\", j.election._id); pm.collectionVariables.set(\"candidateId\", j.candidates[0]._id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{baseUrl}}/elections",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"President\",\n  \"description\": \"Student council president\",\n  \"startTime\": \"2026-10-03T06:41:24.515Z\",\n  \"endTime\": \"2026-10-04T07:41:24.522Z\",\n  \"candidates\": [\n    {\n      \"name\": \"Rahul Sharma\",\n      \"department\": \"CSE\",\n      \"manifesto\": \"Better labs\"\n    },\n    {\n      \"name\": \"Neha Verma\",\n      \"department\": \"ECE\",\n      \"manifesto\": \"More events\"\n    }\n  ]\n}"
            }
          }
        },
        {
          "name": "Add candidate (before start only)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{baseUrl}}/elections/{{electionId}}/candidates",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"New Candidate\",\n  \"department\": \"IT\"\n}"
            }
          }
        },
        {
          "name": "Live results",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{baseUrl}}/elections/{{electionId}}/results"
          }
        }
      ]
    },
    {
      "name": "Voting (student)",
      "item": [
        {
          "name": "List elections",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{baseUrl}}/elections"
          }
        },
        {
          "name": "Election details + candidates",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{baseUrl}}/elections/{{electionId}}"
          }
        },
        {
          "name": "Cast vote",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{baseUrl}}/elections/{{electionId}}/vote",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"candidateId\": \"{{candidateId}}\"\n}"
            }
          }
        },
        {
          "name": "Cast vote again -> 409",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{baseUrl}}/elections/{{electionId}}/vote",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"candidateId\": \"{{candidateId}}\"\n}"
            }
          }
        }
      ]
    }
  ]
}